# J-Quants API（V2・APIキー方式）
# https://jpx-jquants.com/ のダッシュボード「設定 » APIキー」で発行する。
# V1 のメール/パスワード・リフレッシュトークン方式は 2026-06-01 に廃止された。
# このファイルを .env にコピーして値を埋める（.env は .gitignore 済み）。
# 分足（--jquants-minute）は「株価 分足・ティック」アドオン（Light プラン以上）が必要。
JQUANTS_API_KEY=your-jquants-api-key

# Alpaca Market Data API（米国株の分足。無料プランで可）
# https://alpaca.markets/ でアカウント作成 → ダッシュボードで API Key / Secret を発行。
# 発注には使わない（データ取得専用）。ペーパー口座のキーでも可。
ALPACA_API_KEY_ID=your-alpaca-key-id
ALPACA_API_SECRET_KEY=your-alpaca-secret-key

# kabuステーションAPI（本番の発注・板取得。Windows専用アプリ起動が前提）
# API パスワード（/token 用）と取引パスワード（発注用）。本番は不可逆なので取り扱い注意。
KABU_API_PASSWORD=your-kabu-api-password
KABU_TRADE_PASSWORD=your-kabu-trade-password
